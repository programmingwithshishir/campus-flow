<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/routine_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="3dp"
    android:paddingEnd="12dp"
    android:paddingBottom="3dp">

    <ImageView
        android:id="@+id/routine_checkbox"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="Routine Checkbox"
        android:src="@drawable/ic_checkbox_unchecked" />

    <TextView
        android:id="@+id/routine_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/task_text_primary"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/routine_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/empty_text_color"
        android:textSize="13sp" />

</LinearLayout>
